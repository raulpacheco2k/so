# Tema grayscale alinhado à paleta Vantablack do projeto.
# As cores vivas do tema padrão do btop são substituídas por tons de cinza.

theme[main_bg]="#000000"
theme[main_fg]="#ececec"
theme[title]="#ffffff"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#ffffff"
theme[selected_fg]="#000000"
theme[inactive_fg]="#5c5c5c"
theme[proc_misc]="#8d8d8d"
theme[cpu_box]="#8d8d8d"
theme[mem_box]="#8d8d8d"
theme[net_box]="#8d8d8d"
theme[proc_box]="#8d8d8d"
theme[div_line]="#404040"

theme[temp_start]="#5c5c5c"
theme[temp_mid]=""
theme[temp_end]="#ffffff"
theme[cpu_start]="#5c5c5c"
theme[cpu_mid]=""
theme[cpu_end]="#ffffff"
theme[free_start]="#5c5c5c"
theme[free_mid]=""
theme[free_end]="#ffffff"
theme[cached_start]="#5c5c5c"
theme[cached_mid]=""
theme[cached_end]="#ffffff"
theme[available_start]="#5c5c5c"
theme[available_mid]=""
theme[available_end]="#ffffff"
theme[used_start]="#5c5c5c"
theme[used_mid]=""
theme[used_end]="#ffffff"
theme[download_start]="#404040"
theme[download_mid]=""
theme[download_end]="#ffffff"
theme[upload_start]="#404040"
theme[upload_mid]=""
theme[upload_end]="#ffffff"

# Atributos usados pelas versões recentes do btop para a lista de processos.
theme[proc_pause_bg]="#8d8d8d"
theme[proc_follow_bg]="#5c5c5c"
theme[proc_banner_bg]="#404040"
theme[proc_banner_fg]="#ffffff"
theme[followed_bg]="#5c5c5c"
theme[followed_fg]="#ffffff"
