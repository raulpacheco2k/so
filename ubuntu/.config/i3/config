# Configura dinamicamente as saídas RandR e reage a conexoes/desconexoes.
exec_always --no-startup-id sh -c 'if [ -x "$HOME/.config/i3/monitor-hotplug.sh" ]; then setsid -f -- "$HOME/.config/i3/monitor-hotplug.sh"; fi'

# Configurações de Teclado
## Define o layout do teclado para Português Brasileiro (br) com a variante ABNT2.
exec_always --no-startup-id ~/.config/i3/keyboard.sh

# Configurações de TouchPad
## Procura qualquer touchpad para não depender do nome do dispositivo atual.
exec --no-startup-id sh -c 'device=$(xinput list --name-only 2>/dev/null | grep -i "touchpad" | head -n1); if [ -n "$device" ]; then xinput set-prop "$device" "libinput Natural Scrolling Enabled" 1 || true; xinput set-prop "$device" "libinput Tapping Enabled" 1 || true; fi'

# Variaveis: precisam ser definidas antes de qualquer uso nos atalhos.
set $mod Mod4

# i3
## Define a aparência de novas janelas com uma borda e sem barra de título.
for_window [class=".*"] border pixel 1
for_window [class="walker"] floating enable, move position center
## Fecha o walker ao clicar fora dele (i3 IPC watcher)
exec_always --no-startup-id ~/.config/i3/walker-close-on-blur.sh
## Define o tamanho do espaçamento interno entre as janelas
gaps inner 10
## Bloqueia a tela com o lock estilo Vantablack (Omarchy) quando $mod+Shift+l é pressionado.
bindsym $mod+Shift+l exec --no-startup-id ~/.config/i3/lock.sh

# Vantablack theme (monochrome, accent #8d8d8d)
client.focused          #8d8d8d #8d8d8d #000000 #8d8d8d #8d8d8d
client.focused_inactive #000000 #000000 #ececec #404040 #5c5c5c
client.unfocused        #000000 #000000 #5c5c5c #000000 #5c5c5c
client.urgent           #ffffff #ffffff #000000 #ffffff #8d8d8d
client.placeholder      #000000 #000000 #5c5c5c #000000 #000000
client.background       #000000

# Atalhos
bindsym $mod+p exec nautilus
## Captura de tela interativa com Flameshot (X11)
bindsym Print exec --no-startup-id flameshot gui

# Atalho para sites
bindsym $mod+Shift+m exec zen https://webmail709.umbler.com/
bindsym $mod+Shift+x exec zen https://x.com/
bindsym $mod+Shift+g exec zen https://github.com/
bindsym $mod+Shift+w exec zen https://web.whatsapp.com/
bindsym $mod+Shift+y exec zen https://www.youtube.com/

## Launcher de programas
bindsym $mod+d exec --no-startup-id $HOME/.local/bin/walker
# Pre-carrega o Walker e atualiza o ambiente grafico do Elephant.
exec --no-startup-id ~/.config/i3/walker-service.sh

## Wallpaper, when the local image exists
exec_always --no-startup-id feh --bg-fill "$HOME/.config/i3/dot-hands.jpg"

# This file has been auto-generated by i3-config-wizard(1).
# It will not be overwritten, so edit it as you like.
#
# Should you change your keyboard layout some time, delete
# this file and re-run i3-config-wizard(1).
