# Aparencia Vantablack para as notificacoes do Dunst.
[global]
    font = JetBrainsMono Nerd Font 8
    origin = top-right
    offset = (10, 10)
    gap_size = 10
    frame_width = 2
    frame_color = "#8d8d8d"
    separator_color = frame
    corner_radius = 0

[urgency_low]
    background = "#000000"
    foreground = "#8d8d8d"
    frame_color = "#5c5c5c"

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#8d8d8d"

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ffffff"
